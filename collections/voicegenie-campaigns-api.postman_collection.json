          "name": "Add a call to a recurring campaign",
          "request": {
            "name": "Add a call to a recurring campaign",
            "description": {
              "content": "Queue a new call for a customer number inside an existing recurring campaign. The token, workspaceId, campaignId and customerNumber must be present strings; customerNumber must be in E.164 format (leading country code with a plus sign, no spaces, hyphens or brackets).",
